# Public URLs — safe to expose in the browser bundle (NEXT_PUBLIC_*)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Only needed if you want same-origin /trpc/* proxying instead of calling the
# API directly from the browser (see next.config.ts rewrites()).
# API_PROXY_TARGET=http://localhost:8000
# ENABLE_API_PROXY=true
